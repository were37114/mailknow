# IMAP Integration Test Environment Variables
# Copy this file to .env and fill in your credentials
# NEVER commit .env to version control!

# Test email address
MAILMIND_TEST_EMAIL=your-email@example.com

# Password or app-specific password
# For Gmail: Use App Password (https://support.google.com/accounts/answer/185833)
# For 163/QQ: Use authorization code, not your login password
MAILMIND_TEST_PASSWORD=your-password-or-app-password

# Optional: Custom IMAP server (auto-detected for common providers)
# MAILMIND_TEST_SERVER=imap.example.com
# MAILMIND_TEST_PORT=993

# Common IMAP servers:
# Gmail: imap.gmail.com:993
# Outlook: outlook.office365.com:993
# Yahoo: imap.mail.yahoo.com:993
# 163: imap.163.com:993
# QQ: imap.qq.com:993
# 126: imap.126.com:993
